# さくらのAI Engine
SAKURA_AI_TOKEN=
SAKURA_AI_BASE_URL=https://api.ai.sakura.ad.jp/v1
# フェーズ1の疎通確認で選定。子ども向けの日本語・宛先の絞り方・画像入力のすべてで最良だった
# (gpt-oss-120b は正式提供だが、宛先を絞らず画像も読めない)
SAKURA_AI_MODEL=preview/Qwen3-VL-30B-A3B-Instruct

# BFF
PORT=8787
NODE_ENV=development

# 管理画面 (/admin) のトークン。長いランダム文字列にすること
ADMIN_TOKEN=

# 参加者トークンの署名に使う秘密鍵。長いランダム文字列にすること
SESSION_SECRET=

# データの置き場所
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# NGワードのリスト (任意)。1行1語、# から先はコメント。
# 未設定なら server/src/lib/word-filter.ts の既定のリストを使う
NG_WORDS_FILE=
