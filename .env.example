# さくらのAI Engine
SAKURA_AI_TOKEN=
SAKURA_AI_BASE_URL=https://api.ai.sakura.ad.jp/v1
# 以下2つは、部屋で指定しなかったときに使う既定のモデル。
# 部屋ごとのモデルは管理画面で選べる (選択肢は AI Engine の /models から引く)。
# フェーズ1の疎通確認で選定。子ども向けの日本語・宛先の絞り方・画像入力のすべてで最良だった
# (gpt-oss-120b は正式提供だが、宛先を絞らず画像も読めない)
SAKURA_AI_MODEL=preview/Qwen3-VL-30B-A3B-Instruct
# 意見モードの部屋だけ別のモデルを使いたいときに指定する (未設定なら上と同じもの)。
# 意見モードは gemma-4-31B-it で調整した。やり取りのまとめではなく意見から書きはじめるのが
# これだけだった (Qwen3-VL は速いが全員を順番に要約する。Kimi-K2.6 は40〜66秒かかる)
#SAKURA_AI_MODEL_OPINION=preview/gemma-4-31B-it

# BFF
PORT=8787
NODE_ENV=development

# 管理画面 (/admin) のGoogleログイン。
# Google Cloud コンソール > APIとサービス > 認証情報 で
# 「OAuth クライアント ID」を「ウェブ アプリケーション」として作り、その値を入れる。
# 「承認済みの JavaScript 生成元」に管理画面を開くURL (開発なら http://localhost:5173) を登録すること。
GOOGLE_CLIENT_ID=

# 特権管理者のメールアドレス。カンマ区切りで複数書ける。
# ここに書いた人だけが管理者アカウントを登録でき、すべての部屋を管理できる。
# 事前登録なしでログインできるのもここに書いた人だけなので、最低1件は必ず設定すること。
SUPER_ADMIN_EMAILS=

# 管理画面のログインが切れるまでの時間 (時間)。未設定なら12時間
ADMIN_SESSION_TTL_HOURS=12

# データの置き場所。ここは開発用の相対パス。
# 本番では DATA_DIR を /var/lib/kids-group-chat のように絶対パスで書くこと。
DATA_DIR=./data

# 添付ファイルの置き場所 (任意)。未設定なら DATA_DIR の下の uploads が使われる。
# 本番ではこの行を消すのがいちばん安全。相対パスはリポジトリの中 (server/data/uploads) を
# 指すので、systemd の ProtectSystem=strict に阻まれて起動時に ENOENT で落ちる。
# 別の場所に置きたいときだけ、UPLOAD_DIR=/var/lib/kids-group-chat/uploads のように絶対パスで書く。
UPLOAD_DIR=./data/uploads

# NGワードのリスト (任意)。1行1語、# から先はコメント。
# 未設定なら server/src/lib/word-filter.ts の既定のリストを使う
NG_WORDS_FILE=

# 公開URL (任意)。SNSやLINEにURLを貼ったときのプレビュー画像 (OGP) に使う。
# og:image は絶対URLでないとプレビューが出ないので、フロントのビルド時にここの値を埋める。
# 末尾のスラッシュは付けても付けなくてもよい。未設定ならプレビュー画像は出ないだけで、
# 画面の動作には影響しない。npm run build のときに読まれるので、入れたらビルドし直すこと
#SITE_URL=https://kids.example.com
