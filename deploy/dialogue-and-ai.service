# /etc/systemd/system/dialogue-and-ai.service
#
# 置き場所とユーザーは docs/deploy.md の手順に合わせている。
#   アプリ: /opt/dialogue-and-ai   (デプロイで入れ替わる。サービスからは読むだけ)
#   データ: /var/lib/dialogue-and-ai (DBと添付ファイル。StateDirectory が用意する)

[Unit]
Description=dialogue-and-ai BFF
Documentation=https://github.com/kwaka1208/dialogue-and-ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kidschat
Group=kidschat
WorkingDirectory=/opt/dialogue-and-ai
ExecStart=/usr/bin/node server/dist/index.js

# .env にも書くが、書き忘れると cookie の secure が付かず秘密の必須チェックも走らない。
# dotenv は既にある環境変数を上書きしないので、ここで固定しても .env と食い違わない
Environment=NODE_ENV=production
# 1コア1GBのサーバーなので、ヒープが膨らんでスワップに落ちる前に GC させる
Environment=NODE_OPTIONS=--max-old-space-size=320

# /var/lib/dialogue-and-ai を作り、所有者を kidschat にする。.env の DATA_DIR もここを指す
StateDirectory=dialogue-and-ai
StateDirectoryMode=0750

Restart=always
RestartSec=2
# SIGTERM で生成中の本文を保存し、SSEを閉じてから終わる。打ち切りまで最大5秒みている
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dialogue-and-ai

# 触れる範囲を絞る。書けるのは StateDirectory だけ
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=600M

[Install]
WantedBy=multi-user.target
